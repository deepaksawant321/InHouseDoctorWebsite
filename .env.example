# Base URL of the NestJS API (including the /api prefix). Baked into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# DEVELOPMENT ONLY: lets the booking flow skip the UPI proof step (pair with MOCK_PAYMENT_GATEWAY=true on the API). Never set in production.
# NEXT_PUBLIC_ALLOW_SIMULATED_PAYMENT=true
